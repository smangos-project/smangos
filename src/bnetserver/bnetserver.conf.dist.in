############################################
# MaNGOS bnetserver configuration file     #
############################################

[BnetserverConf]
ConfVersion=2026092501

###################################################################################################################
# BNETSERVER SETTINGS
#
#    LoginDatabaseInfo
#        Database connection settings for the realm server.
#        Default: hostname;port;username;password;database
#
#    LogsDir
#         Logs directory setting.
#         Important: Logs dir must exists, or all logs be disable
#         Default: "" - no log directory prefix.
#
#    LoginREST.Port
#        Port of the HTTPS login portal.
#        Default: 8081
#
#    BattlenetPort
#        Port of the Battle.net RPC service (TLS).
#        Default: 1119
#
#    BindIP
#        Bind both ports to this IP/hostname.
#        Default: "0.0.0.0"
#
#    LoginREST.ExternalAddress
#    LoginREST.LocalAddress
#        The hostnames handed to clients so they can reach the portal and the RPC port again. Clients
#        connecting from the loopback address get LocalAddress, everyone else ExternalAddress.
#        Default: "127.0.0.1" for both
#
#    CertificatesFile
#    PrivateKeyFile
#        PEM certificate chain and private key served on both ports.
#        Default: "./bnetserver.cert.pem" and "./bnetserver.key.pem"
#
#    LoginREST.TicketDuration
#        Seconds a login ticket stays valid, and is extended by on every use or refresh.
#        Default: 3600
#
#    LoginREST.SessionDuration
#        Seconds a login portal connection may stay open. 0 = no limit.
#        Default: 300
#
#    Battlenet.LoginTimeout
#        Seconds an RPC connection has to complete its login before it is closed. 0 = no limit.
#        Default: 60
#
#    Battlenet.IdleTimeout
#        Seconds an RPC connection may stay silent before it is closed. 0 = no limit.
#        Default: 600
#
#    Bnet.Region
#    Bnet.Battlegroup
#        The region and battlegroup numbers that go into every realm address.
#        Default: 1 and 1
#
#    RealmsStateUpdateDelay
#        Seconds between re-reads of the realm list. 0 = read once at startup.
#        Default: 20
#
#    MaxPingTime
#        Minutes between database keep-alive pings.
#        Default: 30
#
#    TrustedProxyServers
#        Peers that send a Proxy Protocol v2 header with the real client address, separated by ','.
#        Default: "" - no proxy
#
#    PidFile
#        Default: "" - do not create PID file
#
#    LogLevel.Console
#    LogLevel.File
#        0 = Error; 1 = Minimum; 2 = Basic; 3 = Detail; 4 = Full/Debug
#        Default: 2
#
#    LogTime
#        Include time in console output. Default: 0
#
#    LogFile
#        Logfile name. Default: "Bnetserver.log", "" = no file
#
#    LogTimestamp
#        Add the server start time to the log file name. Default: 0
#
#    LogFileLevel
#        0 = Minimum; 1 = Error; 2 = Detail; 3 = Full/Debug
#        Default: 0
#
#    UseProcessors
#        Used processors mask for multi-processors system (Windows only). Default: 0 (selected by OS)
#
#    ProcessPriority
#        Process priority (Windows only). Default: 1 (HIGH), 0 (Normal)
#
#    WaitAtStartupError
#        After a startup error wait <Enter> or some time before continuing.
#        -1 (wait until <Enter> press), 0 (no wait), N (>0, wait N secs). Default: 5
#
#    WrongPass.MaxAttempts
#        Failed logins from one IP inside the window before that IP is refused. 0 = no limit.
#        Default: 10
#
#    WrongPass.ThrottleWindowDurationSec
#        Default: 60
#
###################################################################################################################

LoginDatabaseInfo = "127.0.0.1;3306;mangos;mangos;realmd"
LogsDir = ""
LoginREST.Port = 8081
BattlenetPort = 1119
BindIP = "0.0.0.0"
LoginREST.ExternalAddress = "127.0.0.1"
LoginREST.LocalAddress = "127.0.0.1"
CertificatesFile = "./bnetserver.cert.pem"
PrivateKeyFile = "./bnetserver.key.pem"
LoginREST.TicketDuration = 3600
LoginREST.SessionDuration = 300
Battlenet.LoginTimeout = 60
Battlenet.IdleTimeout = 600
Bnet.Region = 1
Bnet.Battlegroup = 1
RealmsStateUpdateDelay = 20
MaxPingTime = 30
TrustedProxyServers = ""
PidFile = ""
LogLevel.Console = 2
LogLevel.File = 2
LogTime = 0
LogFile = "Bnetserver.log"
LogTimestamp = 0
LogFileLevel = 0
UseProcessors = 0
ProcessPriority = 1
WaitAtStartupError = 5 # consider fixing your actual problem before changing this value!
WrongPass.MaxAttempts = 10
WrongPass.ThrottleWindowDurationSec = 60
