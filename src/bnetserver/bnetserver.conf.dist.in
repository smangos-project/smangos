############################################
# MaNGOS bnetserver configuration file     #
############################################

[BnetserverConf]
Bnet.ConfVersion=2026100101

###################################################################################################################
# BNETSERVER SETTINGS
#
#    LoginREST.Port
#        Port of the HTTPS login portal.
#        Default: 8081
#
#    BattlenetPort
#        Port of the Battle.net RPC service (TLS).
#        Default: 1119
#
#    Bnet.BindIP
#        Bind both ports to this IP/hostname.
#        Default: "0.0.0.0"
#
#    LoginREST.ExternalAddress
#    LoginREST.LocalAddress
#        The hostnames handed to clients so they can reach the portal and the RPC port again. Clients
#        connecting from the loopback address get LocalAddress, everyone else ExternalAddress.
#        Default: "127.0.0.1" for both
#
#    CertificatesFile
#    PrivateKeyFile
#        PEM certificate chain and private key served on both ports.
#        Default: "config/bnetserver.cert.pem" and "config/bnetserver.key.pem"
#
#    LoginREST.TicketDuration
#        Seconds a login ticket stays valid, and is extended by on every use or refresh.
#        Default: 3600
#
#    LoginREST.SessionDuration
#        Seconds a login portal connection may stay open. 0 = no limit.
#        Default: 300
#
#    Battlenet.LoginTimeout
#        Seconds an RPC connection has to complete its login before it is closed. 0 = no limit.
#        Default: 60
#
#    Battlenet.IdleTimeout
#        Seconds an RPC connection may stay silent before it is closed. 0 = no limit.
#        Default: 600
#
#    MaxPingTime
#        Minutes between database keep-alive pings.
#        Default: 30
#
#    TrustedProxyServers
#        Peers that send a Proxy Protocol v2 header with the real client address, separated by ','.
#        Default: "" - no proxy
#
#    WrongPass.MaxAttempts
#        Failed logins from one IP inside the window before that IP is refused. 0 = no limit.
#        Default: 10
#
#    WrongPass.ThrottleWindowDurationSec
#        Default: 60
#
###################################################################################################################

LoginREST.Port = 8081
BattlenetPort = 1119
Bnet.BindIP = "0.0.0.0"
LoginREST.ExternalAddress = "127.0.0.1"
LoginREST.LocalAddress = "127.0.0.1"
CertificatesFile = "config/bnetserver.cert.pem"
PrivateKeyFile = "config/bnetserver.key.pem"
LoginREST.TicketDuration = 3600
LoginREST.SessionDuration = 300
Battlenet.LoginTimeout = 60
Battlenet.IdleTimeout = 600
MaxPingTime = 30
TrustedProxyServers = ""
WrongPass.MaxAttempts = 10
WrongPass.ThrottleWindowDurationSec = 60
