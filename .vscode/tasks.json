{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure",
      "type": "shell",
      "command": "cmake -S . -B build",
      "problemMatcher": []
    },
    {
      "label": "client: configure",
      "type": "shell",
      "command": "cmake -S . -B build",
      "linux": {
        "command": "cmake -S client -B build-client -DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/toolchain-mingw-w64-x86_64.cmake -DCMAKE_BUILD_TYPE=Release"
      },
      "problemMatcher": []
    },
    {
      "label": "client: build",
      "type": "shell",
      "command": "cmake --build build --config Release --target client_library client_loader",
      "linux": {
        "command": "cmake --build build-client -j"
      },
      "dependsOn": "client: configure",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "client: deploy",
      "type": "shell",
      "command": "Copy-Item bin/Release/custom.dll, bin/Release/custom_launcher.exe .client/_classic_era_ -Force",
      "linux": {
        "command": "cp -f build-client/bin/custom.dll build-client/bin/custom_launcher.exe .client/_classic_era_/"
      },
      "dependsOn": "client: build",
      "problemMatcher": []
    },
    {
      "label": "client: launch",
      "type": "shell",
      "command": "Start-Process -FilePath .client/_classic_era_/custom_launcher.exe -WorkingDirectory .client/_classic_era_",
      "linux": {
        "command": "client/launch-wine-detached.sh ${workspaceFolder}/.client/_classic_era_"
      },
      "dependsOn": "client: deploy",
      "problemMatcher": []
    },
    {
      "label": "client: launch 2",
      "type": "shell",
      "command": "Start-Process -FilePath .client/_classic_era_/custom_launcher.exe -WorkingDirectory .client/_classic_era_",
      "linux": {
        "command": "client/launch-wine-detached.sh ${workspaceFolder}/.client/_classic_era_ & sleep 20; KEEP_RUNNING=1 client/launch-wine-detached.sh ${workspaceFolder}/.client/_classic_era_; wait"
      },
      "dependsOn": "client: deploy",
      "problemMatcher": []
    },
    {
      "label": "worldmapstudio: build and run",
      "type": "shell",
      "command": "tools/map_editor/wms-run.sh",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "worldmapstudio: run (no build)",
      "type": "shell",
      "command": "tools/map_editor/wms-run.sh --no-build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "server: setup",
      "type": "shell",
      "command": "cmake --build build --config RelWithDebInfo --target server_setup",
      "linux": {
        "command": "cmake --build build -j --target server_setup"
      },
      "dependsOn": "configure",
      "problemMatcher": "$gcc"
    },
    {
      "label": "server: run",
      "type": "shell",
      "command": "bin/RelWithDebInfo/server.exe",
      "linux": {
        "command": "build/src/server/server"
      },
      "dependsOn": "server: setup",
      "problemMatcher": []
    },
    {
      "label": "server: run mangosd",
      "type": "shell",
      "command": "bin/RelWithDebInfo/server.exe --services mangosd",
      "linux": {
        "command": "build/src/server/server --services mangosd"
      },
      "dependsOn": "server: setup",
      "problemMatcher": []
    },
    {
      "label": "server: run bnetserver",
      "type": "shell",
      "command": "bin/RelWithDebInfo/server.exe --services bnetserver",
      "linux": {
        "command": "build/src/server/server --services bnetserver"
      },
      "dependsOn": "server: setup",
      "problemMatcher": []
    }
  ]
}