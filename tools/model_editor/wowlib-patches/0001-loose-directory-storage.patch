diff --git a/src/wowlib/fs/loose/loose_storage.hpp b/src/wowlib/fs/loose/loose_storage.hpp
new file mode 100644
index 0000000..e9c0947
--- /dev/null
+++ b/src/wowlib/fs/loose/loose_storage.hpp
@@ -0,0 +1,61 @@
+#pragma once
+
+/** @file
+    The storage backend over a plain directory tree of client files (an
+    extracted client, laid out by client-internal path). Not welded; reached
+    through the FileSystem facade. */
+
+#include <filesystem>
+#include <format>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <wowlib/core/buffer.hpp>
+#include <wowlib/core/client_version.hpp>
+#include <wowlib/core/error.hpp>
+#include <wowlib/core/file_key.hpp>
+#include <wowlib/fs/project_directory.hpp>
+
+namespace wowlib::fs {
+  /** A directory of extracted client files addressed by path (case-insensitive,
+      either slash). It reports itself as an id-addressed (Casc) storage: a
+      listfile in the composition layer supplies the FileDataIDs. */
+  class LooseStorage {
+  public:
+    /** Open (and index) the directory; it must already exist.
+        @param root the extracted client's root directory.
+        @return the storage, or IoError. */
+    static Result<LooseStorage> open(std::filesystem::path root) {
+      std::error_code ec;
+      if (!std::filesystem::is_directory(root, ec))
+        return makeError(ErrorCode::IoError, std::format("'{}' is not a directory", root.string()));
+      auto dir = ProjectDirectory::open(std::move(root));
+      if (!dir) return std::unexpected(dir.error());
+      return LooseStorage{std::move(*dir)};
+    }
+
+    /** Read a file by path.
+        @param key the file identity; its path half is used.
+        @return the bytes, or FileNotFound. */
+    Result<FileBuffer> readFile(const FileKey& key) {
+      if (!key.path)
+        return makeError(ErrorCode::FileNotFound, "no path for this FileDataID (not in the listfile)");
+      return _dir.read(*key.path);
+    }
+
+    /** @param key the file identity.
+        @return true if the path is present. */
+    bool exists(const FileKey& key) { return key.path && _dir.exists(*key.path); }
+
+    /** @return every canonical path in the tree, sorted. */
+    std::vector<std::string> enumeratePaths() const { return _dir.paths(); }
+
+    static constexpr StorageKind kind() { return StorageKind::Casc; }
+
+  private:
+    explicit LooseStorage(ProjectDirectory dir) : _dir(std::move(dir)) {}
+
+    ProjectDirectory _dir;
+  };
+}
