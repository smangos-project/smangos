# Creates whatever of <source root>/.server is missing. Never overwrites or deletes.
# Inputs: SOURCE_DIR, MAP_DATA_DIR (may be empty), CONFIGS ("<template>|<name>,<template>|<name>").

set(server "${SOURCE_DIR}/.server")
set(created FALSE)

foreach(dir config data logs)
  if(NOT IS_DIRECTORY "${server}/${dir}")
    file(MAKE_DIRECTORY "${server}/${dir}")
    message(STATUS "created .server/${dir}")
    set(created TRUE)
  endif()
endforeach()

string(REPLACE "," ";" configs "${CONFIGS}")
foreach(pair IN LISTS configs)
  string(REPLACE "|" ";" parts "${pair}")
  list(GET parts 0 template)
  list(GET parts 1 name)
  if(NOT EXISTS "${server}/config/${name}")
    configure_file("${template}" "${server}/config/${name}" @ONLY)
    message(STATUS "created .server/config/${name}")
    set(created TRUE)
  endif()
endforeach()

foreach(pem bnetserver.cert.pem bnetserver.key.pem)
  if(NOT EXISTS "${server}/config/${pem}")
    file(COPY_FILE "${SOURCE_DIR}/contrib/bnetserver/${pem}" "${server}/config/${pem}")
    message(STATUS "created .server/config/${pem}")
    set(created TRUE)
  endif()
endforeach()

function(link_directory link target)
  if(WIN32)
    file(TO_NATIVE_PATH "${link}" native_link)
    file(TO_NATIVE_PATH "${target}" native_target)
    execute_process(COMMAND cmd /c mklink /J "${native_link}" "${native_target}"
      RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "cannot link ${link} to ${target}: ${error}")
    endif()
  else()
    file(CREATE_LINK "${target}" "${link}" SYMBOLIC)
  endif()
endfunction()

if(MAP_DATA_DIR AND NOT IS_DIRECTORY "${MAP_DATA_DIR}")
  message(FATAL_ERROR "SERVER_MAP_DATA_DIR is not a directory: ${MAP_DATA_DIR}")
endif()

if(NOT EXISTS "${server}/data/maps")
  if(MAP_DATA_DIR)
    link_directory("${server}/data/maps" "${MAP_DATA_DIR}")
    message(STATUS "linked .server/data/maps to ${MAP_DATA_DIR}")
    set(created TRUE)
    foreach(sub vmaps mmaps)
      if(IS_DIRECTORY "${MAP_DATA_DIR}/../${sub}" AND NOT EXISTS "${server}/data/${sub}")
        get_filename_component(target "${MAP_DATA_DIR}/../${sub}" ABSOLUTE)
        link_directory("${server}/data/${sub}" "${target}")
        message(STATUS "linked .server/data/${sub} to ${target}")
      endif()
    endforeach()
  else()
    message(STATUS "no map data: set SERVER_MAP_DATA_DIR to your maps folder and rebuild server_setup")
  endif()
endif()

if(NOT created)
  message(STATUS ".server is up to date")
endif()
